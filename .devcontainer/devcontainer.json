{
  "name": "Assembleur x86 (ESGI)",
  "image": "youssefesgi/asm-esgi:latest",
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "files.associations": { "*.asm": "asm-intel-x86-generic" },
        "editor.tabSize": 4
      }
    }
  },
  "postCreateCommand": "uname -m && nasm -v"
}
